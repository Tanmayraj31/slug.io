# ──────────────────────────────────────────────
# Required — app won't start without these
# ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/url_shortener?schema=public
JWT_SECRET=replace-with-at-least-32-characters

# ──────────────────────────────────────────────
# Required for Docker Compose (Postgres container)
# ──────────────────────────────────────────────
POSTGRES_DB=url_shortener
POSTGRES_USER=url_app
POSTGRES_PASSWORD=localdev123

# ──────────────────────────────────────────────
# Optional — defaults shown
# ──────────────────────────────────────────────
PORT=3000
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
COOKIE_NAME=refreshToken
COOKIE_SECURE=false
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGIN=
BODY_LIMIT=16kb
TRUST_PROXY=false

# Rate limiting (auth)
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=900000

# Rate limiting (API)
RATE_LIMIT_API_MAX=120
RATE_LIMIT_API_WINDOW_MS=60000

# Rate limiting (redirect)
RATE_LIMIT_REDIRECT_MAX=300
RATE_LIMIT_REDIRECT_WINDOW_MS=60000
